# Servidor
PORT=3000
# Prefijo global de la API y CORS para el frontend
CORS_ORIGIN=http://localhost:5173

# SQL Server (on-premise corporativo)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=facturacion_coe
DB_USER=sa
DB_PASSWORD=
# Cifrado de conexión: en on-premise suele ser false + trust del certificado self-signed
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Nombre de instancia (opcional, ej. SQLEXPRESS). Dejar vacío si no aplica.
DB_INSTANCE=
# Logging de SQL de TypeORM (true para depurar)
DB_LOGGING=false

# Autenticación
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Contraseña del admin creado en el primer arranque (cámbiela luego)
ADMIN_PASSWORD=Admin123*

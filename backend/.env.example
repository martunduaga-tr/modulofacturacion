# Servidor
PORT=3000
# Prefijo global de la API y CORS para el frontend
CORS_ORIGIN=http://localhost:5173

# SQL Server (on-premise corporativo)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=facturacion_coe
DB_USER=sa
DB_PASSWORD=
# Cifrado de conexión: en on-premise suele ser false + trust del certificado self-signed
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Nombre de instancia (opcional, ej. SQLEXPRESS). Dejar vacío si no aplica.
DB_INSTANCE=
# Logging de SQL de TypeORM (true para depurar)
DB_LOGGING=false

# Autenticación
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Contraseña del admin creado en el primer arranque (cámbiela luego)
ADMIN_PASSWORD=Admin123*

# BigQuery (empalme): cuenta de servicio de la APLICACIÓN, solo lectura sobre Monitoreo_Transacciones.
# Sin credencial la app funciona igual, liquidando con el CSV exportado.
# En Railway: pegar el contenido del JSON en BQ_CREDENCIALES_JSON. En local: ruta en GOOGLE_APPLICATION_CREDENTIALS.
BQ_CREDENCIALES_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
BQ_PROYECTO=transfiriendocolombia
BQ_VISTA=transfiriendocolombia.Monitoreo_Transacciones.Final_View-Consolidate
# Opcional: SQL exacto de Data. Debe recibir @desde y @hasta (AAAA-MM-DD) y devolver Fecha, NIT, Servicio, Cantidad.
BQ_CONSULTA=
# Liquidación automática del mes anterior (queda en "calculado"; la aprobación sigue siendo humana).
EMPALME_AUTOMATICO=false
# Día 3 de cada mes a las 6:00, hora Colombia
EMPALME_CRON=0 6 3 * *

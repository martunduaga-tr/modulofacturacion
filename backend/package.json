{
  "name": "facturacion-coe-backend",
  "version": "0.1.0",
  "description": "Backend del Sistema de Facturación Automatizada (COE) - Transfiriendo S.A.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
